# ============================================================
# Gozzy Autos — Environment Variables Template (.env.example)
# Copy this file to .env for local development configuration
# ============================================================

# EmDash CMS Encryption Key
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_your_encryption_key_here

# ── reCAPTCHA v3 Configuration ──────────────────────────────
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Local Development SMTP Credentials (astro dev) ───────────
GOZZY_SMTP_SERVER=smtp.mailgun.org
GOZZY_SMTP_PORT=587
GOZZY_SMTP_USERNAME=
GOZZY_SMTP_PASSWORD=

# ── Mailgun HTTP API Configuration ───────────────────────────
GOZZY_MAILGUN_API_KEY=
GOZZY_MAILGUN_DOMAIN=cs.systenics.com

# ── Email Sender & Recipient Configuration ────────────────────
GOZZY_EMAIL_FROM=info@gozzyautos.com
GOZZY_EMAIL_FROM_NAME="Gozzy Autos"
GOZZY_ADMIN_EMAIL=admin@gozzyautos.com
GOZZY_STAFF_EMAIL=info@gozzyautos.com

# Default Email Provider ('auto', 'smtp', 'cloudflare', 'mailgun')
EMAIL_PROVIDER=auto
