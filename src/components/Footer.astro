---
---

<!-- ── ASP Theme Footer ───────────────────────────────────────── -->
<footer class="footer bg-dark text-white pt-5">
	<div class="footer-top pb-4">
		<div class="container">
			<div class="row gy-4">
				<!-- Brand -->
				<div class="col-lg-4 col-md-6">
					<a href="/" class="d-inline-flex align-items-center gap-2 fs-4 fw-bold text-white mb-3 text-decoration-none">
						<span class="badge bg-primary fs-5">🚗</span>
						<span><strong class="text-primary">Gozzy</strong> Autos</span>
					</a>
					<p class="text-white-50 mb-3 f-15">
						Your trusted partner for quality pre-owned vehicles. Find your perfect drive at the best price with full transparency.
					</p>
				</div>

				<!-- Quick Links -->
				<div class="col-lg-4 col-md-6">
					<h5 class="text-white mb-3 fw-semibold">Quick Links</h5>
					<ul class="list-unstyled footer-link">
						<li class="mb-2"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
						<li class="mb-2"><a href="/vehicles" class="text-white-50 text-decoration-none">Featured Vehicles</a></li>
						<li class="mb-2"><a href="/about" class="text-white-50 text-decoration-none">About Us</a></li>
					</ul>
				</div>

				<!-- Contact Info -->
				<div class="col-lg-4 col-md-12">
					<h5 class="text-white mb-3 fw-semibold">Contact & Hours</h5>
					<ul class="list-unstyled footer-link">
						<li class="mb-2">
							<a href="tel:+911234567890" class="text-white-50 text-decoration-none">
								<i class="ph-duotone ph-phone-call text-primary me-2"></i> +91 12345 67890
							</a>
						</li>
						<li class="mb-2">
							<a href="mailto:info@gozzyautos.com" class="text-white-50 text-decoration-none">
								<i class="ph-duotone ph-envelope-simple text-primary me-2"></i> info@gozzyautos.com
							</a>
						</li>
						<li class="mb-2 text-white-50">
							<i class="ph-duotone ph-clock text-primary me-2"></i> Mon–Sat, 10am–7pm
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Bottom Footer -->
	<div class="footer-bottom py-3 border-top border-secondary border-opacity-25">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-md-6 text-center text-md-start">
					<p class="m-0 text-white-50 f-14">
						© {new Date().getFullYear()} Gozzy Autos. All rights reserved.
					</p>
				</div>
				<div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
					<span class="badge bg-secondary bg-opacity-25 text-white-50 f-12">Built with EmDash CMS</span>
				</div>
			</div>
		</div>
	</div>
</footer>
