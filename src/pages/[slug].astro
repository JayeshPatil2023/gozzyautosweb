---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText, Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const sections = Array.isArray(page.data.sections) ? page.data.sections : [];
const hasSections = sections.length > 0;
const hasHeroSection = sections.some((s: any) => s.section_layout === "hero");

// Helper to extract image URL from string, bare ULID, JSON string, or EmDash image media object
function getImageUrl(image: any): string | null {
	if (!image) return null;

	let img = image;

	// If it's a string, check if it's a JSON string or URL or bare ID
	if (typeof img === "string") {
		const trimmed = img.trim();
		if (!trimmed) return null;

		if (trimmed.startsWith("{")) {
			try {
				img = JSON.parse(trimmed);
			} catch (e) {
				// Keep as string if JSON parse fails
			}
		} else {
			if (trimmed.startsWith("/") || trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
				return trimmed;
			}
			return `/_emdash/api/media/file/${trimmed}`;
		}
	}

	// Handle object shape
	if (typeof img === "object" && img !== null) {
		const rawUrl = img.url || img.src || img.path || img.originalUrl || img.previewUrl;
		if (rawUrl && typeof rawUrl === "string" && rawUrl.trim()) {
			const u = rawUrl.trim();
			return (u.startsWith("/") || u.startsWith("http://") || u.startsWith("https://"))
				? u
				: `/_emdash/api/media/file/${u}`;
		}

		// Storage key carries the full filename with extension (e.g. 01JM...png)
		const storageKey = img.meta?.storageKey || img.storageKey || img.key || img.filename;
		if (storageKey && typeof storageKey === "string" && storageKey.trim()) {
			return `/_emdash/api/media/file/${storageKey.trim()}`;
		}

		const idKey = img.id || img._ref;
		if (idKey && typeof idKey === "string" && idKey.trim()) {
			return `/_emdash/api/media/file/${idKey.trim()}`;
		}
	}

	return null;
}

// Helper to determine dynamic container max-width based on admin selection
function getContainerStyle(widthStyle?: string) {
	if (widthStyle === "reading") return "max-width: 900px; margin: 0 auto;";
	if (widthStyle === "narrow") return "max-width: 700px; margin: 0 auto;";
	if (widthStyle === "full") return "max-width: 100%; padding-left: 0; padding-right: 0; margin: 0 auto;";
	// "default" or un-specified: standard 1280px container width
	return "max-width: var(--max-width); margin: 0 auto;";
}
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<!-- Standard Page Header Banner (Hidden if Page uses a Custom Hero Section) -->
	{!hasHeroSection && (
		<section class="py-5 bg-light border-bottom text-center">
			<div class="container py-3">
				<h1 class="display-5 fw-bold text-dark mb-2" {...page.edit.title}>
					{page.data.title}
				</h1>
				{page.data.subtitle && (
					<p class="fs-5 text-muted col-lg-8 mx-auto mb-0" {...page.edit.subtitle}>
						{page.data.subtitle}
					</p>
				)}
			</div>
		</section>
	)}

	{hasSections ? (
		/* Section-Wise Content Renderer */
		<div class="page-sections">
			{sections.map((section: any, index: number) => {
				const isHero = section.section_layout === "hero";
				const isCta = section.section_layout === "cta-banner";
				const isSplitRight = section.section_layout === "split-image-right";
				const isSplitLeft = section.section_layout === "split-image-left";
				const containerStyle = getContainerStyle(section.section_width);

				if (isHero) {
					const heroBgUrl = getImageUrl(section.image);
					return (
						<section class="py-5 bg-light position-relative overflow-hidden" id={`hero-${index}`}>
							<div
								class="position-absolute top-0 start-0 w-100 h-100 opacity-25"
								style={heroBgUrl ? `background: url('${heroBgUrl}') center/cover no-repeat;` : undefined}
							></div>
							<div class="container position-relative z-1 py-4 text-center">
								<div class="col-lg-8 mx-auto">
									{section.section_tag && (
										<span class="section-tag mb-3">
											{section.section_tag}
										</span>
									)}
									{section.section_title && (
										<h1 class="display-4 fw-bold text-dark mb-3">
											{section.section_title}
										</h1>
									)}
									{section.content && (
										<div class="fs-5 text-muted mb-4">
											<Fragment set:html={section.content} />
										</div>
									)}
									{(section.button_text || section.secondary_button_text) && (
										<div class="d-flex justify-content-center gap-3 flex-wrap">
											{section.button_text && (
												<a href={section.button_url || "#"} class="btn btn-primary btn-lg rounded-pill px-4">
													{section.button_text} <i class="ph-duotone ph-arrow-right ms-1"></i>
												</a>
											)}
											{section.secondary_button_text && (
												<a href={section.secondary_button_url || "#"} class="btn btn-outline-secondary btn-lg rounded-pill px-4">
													{section.secondary_button_text}
												</a>
											)}
										</div>
									)}
								</div>
							</div>
						</section>
					);
				}

				if (isCta) {
					return (
						<section class="py-5 bg-white" id={`section-${index}`}>
							<div class="container" style={containerStyle}>
								<div class="p-5 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-4 text-center">
									{section.section_tag && (
										<span class="section-tag mb-2">
											{section.section_tag}
										</span>
									)}
									{section.section_title && (
										<h2 class="fw-bold fs-2 text-dark mb-3">
											{section.section_title}
										</h2>
									)}
									{section.content && (
										<div class="fs-5 text-muted col-lg-8 mx-auto mb-4">
											<Fragment set:html={section.content} />
										</div>
									)}
									{section.button_text && (
										<a href={section.button_url || "#"} class="btn btn-primary btn-lg rounded-pill px-4">
											{section.button_text} <i class="ph-duotone ph-arrow-right ms-1"></i>
										</a>
									)}
								</div>
							</div>
						</section>
					);
				}

				if (isSplitRight || isSplitLeft) {
					const splitImgUrl = getImageUrl(section.image);
					return (
						<section class={`py-5 ${index % 2 === 1 ? "bg-light border-top border-bottom" : "bg-white"}`} id={`section-${index}`}>
							<div class="container" style={containerStyle}>
								<div class="row align-items-center gy-4">
									<div class={`col-lg-6 ${isSplitLeft ? "order-lg-2" : ""}`}>
										{section.section_tag && (
											<span class="section-tag mb-2">{section.section_tag}</span>
										)}
										{section.section_title && (
											<h2 class="fw-bold fs-2 text-dark mb-3">
												{section.section_title}
											</h2>
										)}
										{section.content && (
											<div class="text-muted fs-6 mb-4">
												<Fragment set:html={section.content} />
											</div>
										)}
										{section.button_text && (
											<a href={section.button_url || "#"} class="btn btn-primary rounded-pill px-4">
												{section.button_text} <i class="ph-duotone ph-arrow-right ms-1"></i>
											</a>
										)}
									</div>
									<div class={`col-lg-6 ${isSplitLeft ? "order-lg-1" : ""}`}>
										<div class="rounded-4 overflow-hidden shadow">
											{splitImgUrl ? (
												<img
													src={splitImgUrl}
													alt={section.section_title || ""}
													class="img-fluid w-100"
													style="height: 360px; object-fit: cover;"
												/>
											) : (
												<img
													src="https://images.unsplash.com/photo-1560958089-b8a1929cea89?w=800&q=80"
													alt={section.section_title || ""}
													class="img-fluid w-100"
													style="height: 360px; object-fit: cover;"
												/>
											)}
										</div>
									</div>
								</div>
							</div>
						</section>
					);
				}

				/* Full Width Section with Admin-Selectable Container Width */
				return (
					<section class={`py-5 ${index % 2 === 1 ? "bg-light border-top border-bottom" : "bg-white"}`} id={`section-${index}`}>
						<div class="container" style={containerStyle}>
							{section.section_tag && (
								<span class="section-tag mb-2">{section.section_tag}</span>
							)}
							{section.section_title && (
								<h2 class="fw-bold fs-2 text-dark mb-3">
									{section.section_title}
								</h2>
							)}
							{section.content && (
								<div class="fs-5 text-dark lh-base mb-4">
									<Fragment set:html={section.content} />
								</div>
							)}
							{section.button_text && (
								<div>
									<a href={section.button_url || "#"} class="btn btn-primary rounded-pill px-4">
										{section.button_text} <i class="ph-duotone ph-arrow-right ms-1"></i>
									</a>
								</div>
							)}
						</div>
					</section>
				);
			})}
		</div>
	) : (
		/* Fallback PortableText Rich Text Content */
		<div class="container py-5" style="max-width: 800px;">
			<article class="prose fs-5 lh-lg text-dark">
				<PortableText value={page.data.content} />
			</article>
		</div>
	)}
</Base>
