---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

// ── Fetch featured vehicles from EmDash ───────────────────────────────────
// We fetch all vehicles and show the ones marked as "Show on Home Page"
const { entries: vehicles, cacheHint } = await getEmDashCollection("vehicles", {
	orderBy: { published_at: "desc" },
});

// ── Fetch home page section content from EmDash CMS ───────────────────────
let homeData: Record<string, any> = {};
let homeEditProps: Record<string, any> = {};

try {
	const { entries: homeEntries } = await getEmDashCollection("home_page");
	if (homeEntries && homeEntries.length > 0) {
		homeData = homeEntries[0].data || {};
		homeEditProps = homeEntries[0].edit || {};
	}
} catch (e) {
	// Fallback if home_page collection is not yet populated
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Filter only featured vehicles for the home page grid
const featuredVehicles = vehicles.filter((v) => v.data.is_featured);

// Helper: format price in Indian Rupee notation
function formatPrice(price?: number | null): string {
	if (!price) return "Price on Request";
	if (price >= 100000) {
		return `₹${(price / 100000).toFixed(1)} Lakh`;
	}
	return `₹${price.toLocaleString("en-IN")}`;
}

// Helper: format mileage
function formatMileage(km?: number | null): string {
	if (!km) return "—";
	return `${km.toLocaleString("en-IN")} km`;
}

// CMS Values with Fallbacks
const heroBadge = homeData.hero_badge || "Trusted Auto Dealership";
const heroHeadline = homeData.hero_headline || "Find Your";
const heroAccentText = homeData.hero_accent_text || "Perfect Drive";
const heroSubheadline = homeData.hero_subheadline || "Browse our handpicked collection of quality pre-owned vehicles. Every car is inspected, verified, and ready to drive home today.";
const heroPrimaryBtnText = homeData.hero_primary_btn_text || "Browse Vehicles";
const heroPrimaryBtnUrl = homeData.hero_primary_btn_url || "/vehicles";
const heroSecondaryBtnText = homeData.hero_secondary_btn_text || "Learn More";
const heroSecondaryBtnUrl = homeData.hero_secondary_btn_url || "/about";

const stat1Value = homeData.stat1_value || `${vehicles.length}+`;
const stat1Label = homeData.stat1_label || "Cars Available";
const stat2Value = homeData.stat2_value || "500+";
const stat2Label = homeData.stat2_label || "Happy Customers";
const stat3Value = homeData.stat3_value || "100%";
const stat3Label = homeData.stat3_label || "Verified Stock";

const vehiclesTag = homeData.vehicles_tag || "Top Picks";
const vehiclesTitle = homeData.vehicles_title || "Most Searched Vehicles";
const vehiclesDesc = homeData.vehicles_description || "Our customers love these models. Handpicked for quality, performance, and value.";

const whyTag = homeData.why_tag || "Why Gozzy Autos";
const whyTitle = homeData.why_title || "Your Satisfaction is Our Top Priority";
const whyDesc = homeData.why_description || "We're not just selling cars — we're helping you make one of the most important purchases of your life. Every vehicle in our lot is thoroughly inspected and comes with full transparency.";

// Helper to extract image URL from string, bare ULID, JSON string, or EmDash image media object
function getImageUrl(image: any): string | null {
	if (!image) return null;

	let img = image;

	if (typeof img === "string") {
		const trimmed = img.trim();
		if (!trimmed) return null;

		if (trimmed.startsWith("{")) {
			try {
				img = JSON.parse(trimmed);
			} catch (e) {
				// Keep as string if JSON parse fails
			}
		} else {
			if (trimmed.startsWith("/") || trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
				return trimmed;
			}
			return `/_emdash/api/media/file/${trimmed}`;
		}
	}

	if (typeof img === "object" && img !== null) {
		const rawUrl = img.url || img.src || img.path || img.originalUrl || img.previewUrl;
		if (rawUrl && typeof rawUrl === "string" && rawUrl.trim()) {
			const u = rawUrl.trim();
			return (u.startsWith("/") || u.startsWith("http://") || u.startsWith("https://"))
				? u
				: `/_emdash/api/media/file/${u}`;
		}

		// Storage key carries the full filename with extension (e.g. 01JM...png)
		const storageKey = img.meta?.storageKey || img.storageKey || img.key || img.filename;
		if (storageKey && typeof storageKey === "string" && storageKey.trim()) {
			return `/_emdash/api/media/file/${storageKey.trim()}`;
		}

		const idKey = img.id || img._ref;
		if (idKey && typeof idKey === "string" && idKey.trim()) {
			return `/_emdash/api/media/file/${idKey.trim()}`;
		}
	}

	return null;
}

const heroBgUrl = getImageUrl(homeData.hero_bg_image);
---

<Base title={siteTitle} description={siteTagline}>

	<!-- ═══════════════════════════════════════════════════════
	     SECTION 1: HERO (ASP Light Able Header Style)
	     ═══════════════════════════════════════════════════════ -->
	<section class="py-5 bg-light position-relative overflow-hidden" id="hero">
		<!-- Background image / overlay -->
		<div
			class="position-absolute top-0 start-0 w-100 h-100 opacity-25"
			style={heroBgUrl ? `background: url('${heroBgUrl}') center/cover no-repeat;` : undefined}
		></div>

		<div class="container position-relative z-1 py-4 py-lg-5">
			<div class="row align-items-center gy-4">
				<div class="col-lg-7">
					<!-- Badge -->
					<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fs-6" {...homeEditProps.hero_badge}>
						{heroBadge}
					</span>

					<!-- Headline -->
					<h1 class="display-4 fw-bold mb-3 text-dark" {...homeEditProps.hero_headline}>
						{heroHeadline} <span class="text-primary" {...homeEditProps.hero_accent_text}>{heroAccentText}</span>
					</h1>

					<!-- Subheadline -->
					<p class="fs-5 text-muted mb-4 pe-lg-4" {...homeEditProps.hero_subheadline}>
						{heroSubheadline}
					</p>

					<!-- CTA Buttons -->
					<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
						<a href={heroPrimaryBtnUrl} class="btn btn-primary btn-lg shadow-sm" id="hero-browse-btn" {...homeEditProps.hero_primary_btn_text}>
							{heroPrimaryBtnText} <i class="ph-duotone ph-arrow-right ms-1"></i>
						</a>
						<a href={heroSecondaryBtnUrl} class="btn btn-outline-secondary btn-lg" id="hero-about-btn" {...homeEditProps.hero_secondary_btn_text}>
							{heroSecondaryBtnText}
						</a>
					</div>

					<!-- Stats bar -->
					<div class="row g-3 pt-3 border-top">
						<div class="col-4">
							<div class="fw-bold fs-3 text-dark" {...homeEditProps.stat1_value}>{stat1Value || `${vehicles.length}+`}</div>
							<div class="text-muted f-13 text-uppercase" {...homeEditProps.stat1_label}>{stat1Label}</div>
						</div>
						<div class="col-4">
							<div class="fw-bold fs-3 text-dark" {...homeEditProps.stat2_value}>{stat2Value}</div>
							<div class="text-muted f-13 text-uppercase" {...homeEditProps.stat2_label}>{stat2Label}</div>
						</div>
						<div class="col-4">
							<div class="fw-bold fs-3 text-dark" {...homeEditProps.stat3_value}>{stat3Value}</div>
							<div class="text-muted f-13 text-uppercase" {...homeEditProps.stat3_label}>{stat3Label}</div>
						</div>
					</div>
				</div>

				<div class="col-lg-5 text-center">
					<div class="card border-0 shadow-lg overflow-hidden rounded-4">
						<img
							src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=800&q=80"
							alt="Gozzy Autos Showcase"
							class="img-fluid"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════
	     SECTION 2: MOST SEARCHED VEHICLES (ASP Cards)
	     ═══════════════════════════════════════════════════════ -->
	<section class="py-5 bg-white" id="most-searched-vehicles">
		<div class="container py-4">
			<div class="text-center mb-5">
				<span class="section-tag mb-2" {...homeEditProps.vehicles_tag}>{vehiclesTag}</span>
				<h2 class="fw-bold fs-2 text-dark" {...homeEditProps.vehicles_title}>{vehiclesTitle}</h2>
				<p class="text-muted col-lg-6 mx-auto" {...homeEditProps.vehicles_description}>
					{vehiclesDesc}
				</p>
			</div>

			{featuredVehicles.length === 0 ? (
				<div class="text-center py-5 bg-light rounded-4">
					<p class="fs-1 mb-2">🚗</p>
					<p class="text-muted">No featured vehicles available right now.</p>
					<p class="mt-2">
						<a href="/_emdash/admin/content/vehicles/new" class="btn btn-sm btn-primary">
							Add your first vehicle →
						</a>
					</p>
				</div>
			) : (
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{featuredVehicles.map((vehicle) => (
						<div class="col">
							<article class="card h-100 border shadow-sm hover-shadow transition-all rounded-3" id={`vehicle-${vehicle.id}`}>
								<div class="vehicle-card-image position-relative">
									{vehicle.data.featured_image
										? <Image image={vehicle.data.featured_image} alt={vehicle.data.title} class="card-img-top" />
										: (
											<div class="d-flex align-items-center justify-content-center bg-light text-muted fs-1" style="height: 220px;">
												🚗
											</div>
										)
									}
									<span class="badge bg-primary position-absolute top-0 start-0 m-3">Featured</span>
								</div>

								<div class="card-body d-flex flex-column">
									<div class="d-flex align-items-center gap-2 mb-2">
										<span class="badge bg-primary-subtle text-primary">{vehicle.data.year}</span>
										{vehicle.data.fuel_type && (
											<small class="text-muted">{vehicle.data.fuel_type}</small>
										)}
									</div>

									<h5 class="card-title fw-bold text-dark mb-2">{vehicle.data.make} {vehicle.data.model}</h5>

									<div class="d-flex gap-2 flex-wrap mb-3">
										{vehicle.data.transmission && (
											<span class="badge bg-light text-dark border">{vehicle.data.transmission}</span>
										)}
										{vehicle.data.mileage && (
											<span class="badge bg-light text-dark border">🛣️ {formatMileage(vehicle.data.mileage)}</span>
										)}
									</div>

									{vehicle.data.short_description && (
										<p class="card-text text-muted small mb-3 flex-grow-1">{vehicle.data.short_description}</p>
									)}

									<div class="pt-3 border-top mt-auto d-flex align-items-center justify-content-between">
										<div class="fw-bold fs-5 text-dark">
											{formatPrice(vehicle.data.price)}
										</div>
										<a
											href={`/vehicles/${vehicle.id}`}
											class="btn btn-outline-primary btn-sm rounded-pill"
											id={`vehicle-details-${vehicle.id}`}
										>
											View Details
										</a>
									</div>
								</div>
							</article>
						</div>
					))}
				</div>
			)}

			{featuredVehicles.length > 0 && (
				<div class="text-center mt-5">
					<a href="/vehicles" class="btn btn-outline-dark btn-lg rounded-pill" id="view-all-vehicles-btn">
						View All Vehicles <i class="ph-duotone ph-arrow-right ms-1"></i>
					</a>
				</div>
			)}
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════
	     SECTION 3: WHY CHOOSE US (Split Section)
	     ═══════════════════════════════════════════════════════ -->
	<section class="py-5 bg-light border-top border-bottom" id="why-choose-us">
		<div class="container py-4">
			<div class="row align-items-center gy-4">
				<!-- Image side -->
				<div class="col-lg-6">
					<div class="rounded-4 overflow-hidden shadow-lg position-relative">
						<img
							src="https://images.unsplash.com/photo-1560958089-b8a1929cea89?w=800&q=80"
							alt="Car showroom at Gozzy Autos"
							class="img-fluid w-100"
						/>
					</div>
				</div>

				<!-- Info side -->
				<div class="col-lg-6 ps-lg-4">
					<span class="section-tag mb-2" {...homeEditProps.why_tag}>{whyTag}</span>
					<h2 class="fw-bold fs-2 text-dark mb-3" {...homeEditProps.why_title}>{whyTitle}</h2>
					<p class="text-muted fs-6 mb-4" {...homeEditProps.why_description}>
						{whyDesc}
					</p>

					<div class="row g-3 mb-4">
						<div class="col-sm-6">
							<div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border">
								<div class="fs-4 text-primary"><i class="ph-duotone ph-check-circle"></i></div>
								<div>
									<h6 class="fw-bold mb-1 text-dark">100% Verified Stock</h6>
									<small class="text-muted">Rigorous 150-point vehicle inspection.</small>
								</div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border">
								<div class="fs-4 text-primary"><i class="ph-duotone ph-currency-circle-dollar"></i></div>
								<div>
									<h6 class="fw-bold mb-1 text-dark">Transparent Pricing</h6>
									<small class="text-muted">No hidden fees or surprise charges.</small>
								</div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border">
								<div class="fs-4 text-primary"><i class="ph-duotone ph-handshake"></i></div>
								<div>
									<h6 class="fw-bold mb-1 text-dark">Easy Financing</h6>
									<small class="text-muted">Instant loan assistance & low rates.</small>
								</div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border">
								<div class="fs-4 text-primary"><i class="ph-duotone ph-file-text"></i></div>
								<div>
									<h6 class="fw-bold mb-1 text-dark">Hassle-Free RC Transfer</h6>
									<small class="text-muted">Complete end-to-end paperwork support.</small>
								</div>
							</div>
						</div>
					</div>

					<a href="/about" class="btn btn-primary rounded-pill px-4" id="why-choose-learn-more-btn">
						Learn More About Us <i class="ph-duotone ph-arrow-right ms-1"></i>
					</a>
				</div>
			</div>
		</div>
	</section>

</Base>
