---
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getSiteSettings } from "emdash";

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
---

<Base
	title={`Contact Us — ${siteTitle}`}
	description="Get in touch with Gozzy Autos for inquiries about pre-owned vehicles, financing, or test drives."
>
	<link rel="stylesheet" href="/css/contact.css" slot="head" />

	<!-- ── Page Header Banner ──────────────────────────────────── -->
	<section class="contact-header">
		<div class="container">
			<span class="section-tag">Get in Touch</span>
			<h1>Contact Us</h1>
			<p class="contact-header-sub">
				Have questions about a vehicle, pricing, or financing options? Send us a message and our expert sales team will get back to you shortly.
			</p>
		</div>
	</section>

	<!-- ── Main Contact Section ─────────────────────────────────── -->
	<section class="section contact-section">
		<div class="container">
			<div class="contact-grid">

				<!-- Contact Form Card -->
				<div class="contact-card form-card">
					<h2>Send Us a Message</h2>

					<!-- Success Alert Banner -->
					<div id="contact-success-alert" class="alert alert-success is-hidden" role="alert">
						<i class="ph-duotone ph-check-circle alert-icon"></i>
						<span id="contact-success-text">Thank you! Your message has been sent successfully.</span>
					</div>

					<!-- Error Alert Banner -->
					<div id="contact-error-alert" class="alert alert-danger is-hidden" role="alert">
						<i class="ph-duotone ph-warning-circle alert-icon"></i>
						<span id="contact-error-text">An error occurred. Please try again.</span>
					</div>

					<!-- Form -->
					<form id="contact-form" novalidate>
						<div class="form-grid">
							<!-- First Name -->
							<div class="form-group">
								<label for="firstName">First Name <span class="required">*</span></label>
								<input
									type="text"
									id="firstName"
									name="firstName"
									placeholder="e.g. Rahul"
									required
								/>
							</div>

							<!-- Last Name -->
							<div class="form-group">
								<label for="lastName">Last Name <span class="required">*</span></label>
								<input
									type="text"
									id="lastName"
									name="lastName"
									placeholder="e.g. Sharma"
									required
								/>
							</div>

							<!-- Email Address -->
							<div class="form-group">
								<label for="email">Email Address <span class="required">*</span></label>
								<input
									type="email"
									id="email"
									name="email"
									placeholder="rahul@example.com"
									required
								/>
							</div>

							<!-- Phone Number -->
							<div class="form-group">
								<label for="phone">Phone Number <span class="required">*</span></label>
								<input
									type="tel"
									id="phone"
									name="phone"
									placeholder="+91 98765 43210"
									required
								/>
							</div>

							<!-- Comments / Message -->
							<div class="form-group full-width">
								<label for="comments">Comments / Message <span class="required">*</span></label>
								<textarea
									id="comments"
									name="comments"
									rows="5"
									placeholder="Tell us about the vehicle you are interested in or ask any question..."
									required
								></textarea>
							</div>

							<!-- Submit Button -->
							<div class="form-group full-width form-actions">
								<button type="submit" id="contact-submit-btn" class="btn btn-primary btn-lg">
									<span id="btn-text">Send Message</span>
									<i class="ph-duotone ph-paper-plane-tilt" id="btn-icon"></i>
								</button>
							</div>
						</div>
					</form>
				</div>

				<!-- Dealership Contact Info Card -->
				<div class="contact-card info-card">
					<h2>Dealership Information</h2>

					<div class="info-list">
						<div class="info-item">
							<div class="info-icon">
								<i class="ph-duotone ph-map-pin"></i>
							</div>
							<div class="info-details">
								<h3>Showroom Address</h3>
								<p>
									Gozzy Autos Dealership Hub,<br />
									Auto Market Road, Sector 12,<br />
									Mumbai, Maharashtra — 400001
								</p>
							</div>
						</div>

						<div class="info-item">
							<div class="info-icon">
								<i class="ph-duotone ph-phone-call"></i>
							</div>
							<div class="info-details">
								<h3>Phone Number</h3>
								<a href="tel:+911234567890">+91 12345 67890</a>
							</div>
						</div>

						<div class="info-item">
							<div class="info-icon">
								<i class="ph-duotone ph-envelope-simple"></i>
							</div>
							<div class="info-details">
								<h3>Email Address</h3>
								<a href="mailto:info@gozzyautos.com">info@gozzyautos.com</a>
							</div>
						</div>

						<div class="info-item">
							<div class="info-icon">
								<i class="ph-duotone ph-clock"></i>
							</div>
							<div class="info-details">
								<h3>Working Hours</h3>
								<p>
									Monday – Saturday: 10:00 AM – 7:00 PM<br />
									Sunday: By Appointment Only
								</p>
							</div>
						</div>
					</div>

					<div class="info-cta-box">
						<h3>Need Immediate Assistance?</h3>
						<p>Browse our complete stock of verified vehicles or call our direct sales hotline.</p>
						<a href="/vehicles" class="btn btn-outline w-full">
							Browse Vehicle Inventory <i class="ph-duotone ph-arrow-right"></i>
						</a>
					</div>
				</div>

			</div>
		</div>
	</section>

	<script is:inline src="/js/contact.js"></script>
</Base>

