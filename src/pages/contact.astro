---
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getSiteSettings } from "emdash";

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
---

<Base
	title={`Contact Us — ${siteTitle}`}
	description="Get in touch with Gozzy Autos for inquiries about pre-owned vehicles, financing, or test drives."
>
	<!-- ── Page Banner ─────────────────────────────────────────── -->
	<section class="py-5 bg-light border-bottom text-center">
		<div class="container py-3">
			<span class="section-tag mb-2">Get in Touch</span>
			<h1 class="display-5 fw-bold text-dark mb-2">Contact Us</h1>
			<p class="fs-5 text-muted col-lg-7 mx-auto mb-0">
				Have questions about a vehicle, pricing, or financing options? Send us a message and our expert sales team will get back to you shortly.
			</p>
		</div>
	</section>

	<!-- ── Main Contact Section ─────────────────────────────────── -->
	<section class="py-5 bg-white">
		<div class="container py-4">
			<div class="row gy-4">

				<!-- Contact Form Column -->
				<div class="col-lg-7">
					<div class="card border shadow-sm rounded-4 p-4 p-md-5 bg-white">
						<h3 class="fw-bold text-dark mb-4">Send Us a Message</h3>

						<!-- Success Alert Banner -->
						<div id="contact-success-alert" class="alert alert-success d-none rounded-3 mb-4" role="alert">
							<div class="d-flex align-items-center gap-2">
								<i class="ph-duotone ph-check-circle fs-4"></i>
								<span id="contact-success-text">Thank you! Your message has been sent successfully.</span>
							</div>
						</div>

						<!-- Error Alert Banner -->
						<div id="contact-error-alert" class="alert alert-danger d-none rounded-3 mb-4" role="alert">
							<div class="d-flex align-items-center gap-2">
								<i class="ph-duotone ph-warning-circle fs-4"></i>
								<span id="contact-error-text">An error occurred. Please try again.</span>
							</div>
						</div>

						<!-- Form -->
						<form id="contact-form" novalidate>
							<div class="row g-3">
								<!-- First Name -->
								<div class="col-md-6">
									<label for="firstName" class="form-label fw-semibold text-dark">First Name <span class="text-danger">*</span></label>
									<input
										type="text"
										class="form-control rounded-3 py-2 px-3"
										id="firstName"
										name="firstName"
										placeholder="e.g. Rahul"
										required
									/>
								</div>

								<!-- Last Name -->
								<div class="col-md-6">
									<label for="lastName" class="form-label fw-semibold text-dark">Last Name <span class="text-danger">*</span></label>
									<input
										type="text"
										class="form-control rounded-3 py-2 px-3"
										id="lastName"
										name="lastName"
										placeholder="e.g. Sharma"
										required
									/>
								</div>

								<!-- Email Address -->
								<div class="col-md-6">
									<label for="email" class="form-label fw-semibold text-dark">Email Address <span class="text-danger">*</span></label>
									<input
										type="email"
										class="form-control rounded-3 py-2 px-3"
										id="email"
										name="email"
										placeholder="rahul@example.com"
										required
									/>
								</div>

								<!-- Phone Number -->
								<div class="col-md-6">
									<label for="phone" class="form-label fw-semibold text-dark">Phone Number <span class="text-danger">*</span></label>
									<input
										type="tel"
										class="form-control rounded-3 py-2 px-3"
										id="phone"
										name="phone"
										placeholder="+91 98765 43210"
										required
									/>
								</div>

								<!-- Comments / Message -->
								<div class="col-12">
									<label for="comments" class="form-label fw-semibold text-dark">Comments / Message <span class="text-danger">*</span></label>
									<textarea
										class="form-control rounded-3 p-3"
										id="comments"
										name="comments"
										rows="5"
										placeholder="Tell us about the vehicle you are interested in or ask any question..."
										required
									></textarea>
								</div>

								<!-- Submit Button -->
								<div class="col-12 mt-4">
									<button type="submit" id="contact-submit-btn" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm w-100 w-md-auto">
										<span id="btn-text">Send Message</span>
										<i class="ph-duotone ph-paper-plane-tilt ms-1" id="btn-icon"></i>
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>

				<!-- Dealership Contact Info Column -->
				<div class="col-lg-5">
					<div class="card border-0 bg-light rounded-4 p-4 p-md-5 h-100">
						<h3 class="fw-bold text-dark mb-4">Dealership Information</h3>

						<div class="d-flex align-items-start gap-3 mb-4">
							<div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
								<i class="ph-duotone ph-map-pin"></i>
							</div>
							<div>
								<h6 class="fw-bold text-dark mb-1">Showroom Address</h6>
								<p class="text-muted small mb-0">
									Gozzy Autos Dealership Hub,<br />
									Auto Market Road, Sector 12,<br />
									Mumbai, Maharashtra — 400001
								</p>
							</div>
						</div>

						<div class="d-flex align-items-start gap-3 mb-4">
							<div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
								<i class="ph-duotone ph-phone-call"></i>
							</div>
							<div>
								<h6 class="fw-bold text-dark mb-1">Phone Number</h6>
								<a href="tel:+911234567890" class="text-decoration-none text-muted small">
									+91 12345 67890
								</a>
							</div>
						</div>

						<div class="d-flex align-items-start gap-3 mb-4">
							<div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
								<i class="ph-duotone ph-envelope-simple"></i>
							</div>
							<div>
								<h6 class="fw-bold text-dark mb-1">Email Address</h6>
								<a href="mailto:info@gozzyautos.com" class="text-decoration-none text-muted small">
									info@gozzyautos.com
								</a>
							</div>
						</div>

						<div class="d-flex align-items-start gap-3 mb-4">
							<div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
								<i class="ph-duotone ph-clock"></i>
							</div>
							<div>
								<h6 class="fw-bold text-dark mb-1">Working Hours</h6>
								<p class="text-muted small mb-0">
									Monday – Saturday: 10:00 AM – 7:00 PM<br />
									Sunday: By Appointment Only
								</p>
							</div>
						</div>

						<hr class="my-4" />

						<div class="bg-white p-3 rounded-3 border">
							<h6 class="fw-bold text-dark mb-2">Need Immediate Assistance?</h6>
							<p class="text-muted small mb-3">
								Browse our complete stock of verified vehicles or call our direct sales hotline.
							</p>
							<a href="/vehicles" class="btn btn-outline-primary btn-sm rounded-pill w-100">
								Browse Vehicle Inventory <i class="ph-duotone ph-arrow-right ms-1"></i>
							</a>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- Client-side AJAX Submission Script -->
	<script is:inline>
		document.addEventListener("DOMContentLoaded", () => {
			const form = document.getElementById("contact-form");
			const submitBtn = document.getElementById("contact-submit-btn");
			const btnText = document.getElementById("btn-text");
			const btnIcon = document.getElementById("btn-icon");
			const successAlert = document.getElementById("contact-success-alert");
			const successText = document.getElementById("contact-success-text");
			const errorAlert = document.getElementById("contact-error-alert");
			const errorText = document.getElementById("contact-error-text");

			if (!form) return;

			form.addEventListener("submit", async (e) => {
				e.preventDefault();

				// Reset alerts
				successAlert.classList.add("d-none");
				errorAlert.classList.add("d-none");

				const firstName = document.getElementById("firstName").value.trim();
				const lastName = document.getElementById("lastName").value.trim();
				const email = document.getElementById("email").value.trim();
				const phone = document.getElementById("phone").value.trim();
				const comments = document.getElementById("comments").value.trim();

				// Client validation
				if (!firstName || !lastName || !email || !phone || !comments) {
					errorText.textContent = "Please fill in all required fields.";
					errorAlert.classList.remove("d-none");
					return;
				}

				// Disable submit button & show loading state
				submitBtn.disabled = true;
				btnText.textContent = "Sending Message...";
				btnIcon.className = "ph-duotone ph-spinner spinner ms-1";

				try {
					const res = await fetch("/api/contact", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"Accept": "application/json",
						},
						body: JSON.stringify({
							firstName,
							lastName,
							email,
							phone,
							comments,
						}),
					});

					const data = await res.json();

					if (res.ok && data.success) {
						successText.textContent = data.message || "Thank you! Your message has been sent successfully.";
						successAlert.classList.remove("d-none");
						form.reset();
					} else {
						errorText.textContent = data.message || "Failed to send message. Please try again.";
						errorAlert.classList.remove("d-none");
					}
				} catch (err) {
					console.error("Submission error:", err);
					errorText.textContent = "Network error while sending message. Please try again later.";
					errorAlert.classList.remove("d-none");
				} finally {
					// Restore button state
					submitBtn.disabled = false;
					btnText.textContent = "Send Message";
					btnIcon.className = "ph-duotone ph-paper-plane-tilt ms-1";
				}
			});
		});
	</script>
</Base>
